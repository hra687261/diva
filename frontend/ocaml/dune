; The OCaml frontend. `compiler-libs.common` is the OCaml compiler's
; parser and type checker.

(executable
 (name frontend)
 (modules frontend prelude_text)
 (libraries compiler-libs.common))

; the text of the prelude, as the string `Prelude_text.text`
(rule
 (with-stdout-to
  prelude_text.ml
  (progn
   (echo "let text = {diva|")
   (cat prelude.ml)
   (echo "|diva}\n"))))

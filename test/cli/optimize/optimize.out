$ diva run optimize.ml
163
[exit 0]

$ diva check optimize.ml
no runtime error is possible
[exit 0]

$ diva opt optimize.ml
(let scale = (fun x -> (if (x < 0) then 0 else x)) in (let clamp = (fun x -> (if (x < 0) then 0 else x)) in ((scale 160) + (clamp 3))))
[exit 0]

$ diva hints optimize.ml
x#0 : 160
x#1 : 3
[exit 0]

$ diva cert --check optimize.ml
[diva] running Lean on optimize.lean
wrote optimize.lean
certificate checked by Lean: the program never fails
[exit 0]

$ diva prove --check -o prove.lean optimize.ml
no function has a contract: write one in a `(*@ ... *)` comment after a function
[exit 1]

$ diva opt --cert --check -o opt.lean optimize.ml
[diva] running Lean on opt.lean
wrote opt.lean
certificate checked by Lean: the optimised program is equivalent to the program
[exit 0]


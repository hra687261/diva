$ diva run optimize.ml
163
[exit 0]

$ diva check optimize.ml
no runtime error is possible
[exit 0]

$ diva opt optimize.ml
(let width = 8 in (let height = 20 in (let area = 160 in (let debug = false in (let scale = (fun x -> (if (x < 0) then 0 else x)) in (let clamp = (fun x -> (if (x < 0) then 0 else (let _ = () in x))) in ((scale 160) + (clamp 3))))))))
[exit 0]

$ diva hints optimize.ml
x#0 : 160
x#1 : 3
[exit 0]

$ diva cert --check optimize.ml
wrote optimize.lean
certificate checked by Lean: the program never fails
[exit 0]


$ diva run sumsq.ml
385
[exit 0]

$ diva check sumsq.ml
no runtime error is possible
[exit 0]

$ diva opt sumsq.ml
(let rec sumsq n = (fun acc -> (if (n = 0) then acc else (let acc = (acc + (n * n)) in (if (acc < 0) then 0 else ((sumsq (n - 1)) acc))))) in ((sumsq 10) 0))
[exit 0]

$ diva hints sumsq.ml
n#1 : [-∞, 10]
$sumsq#0 : [0, +∞]
acc#2 : [0, +∞]
[exit 0]


$ diva run no_contract.ml
34
[exit 0]

$ diva check no_contract.ml
no runtime error is possible
[exit 0]

$ diva opt no_contract.ml
(let half = (fun x -> (x / 2)) in (let inv = (fun x -> (100 / x)) in (let f = (fun x -> ((half x) + (inv x))) in (f 3))))
[exit 0]

$ diva hints no_contract.ml
x#0 : 3
x#1 : 3
x#2 : ⊥
x#3 : 3
[exit 0]


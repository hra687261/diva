$ diva opt buggy.ml
(let rec count l = (match l with [] -> 0 | _ :: t -> (1 + (count t))) in (let rec sum l = (match l with [] -> 0 | x :: xs -> (x + (sum xs))) in (let average = (fun l -> ((sum l) / (count l))) in (let a = (average (1 :: (2 :: (3 :: [])))) in (let b = (average []) in (a + b))))))
[exit 0]


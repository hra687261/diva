$ diva ocaml opt lists.ml
(let Stdlib.List.hd = (fun %p8 -> (match %p8 with [] -> (raise Failure) | a :: _ -> a)) in (let l = (3 :: (1 :: (2 :: []))) in (let a = (Stdlib.List.hd l) in (let second = (fun l -> (let %t1 = (fun _ -> 0) in (match l with [] -> (%t1 ()) | _ :: %t2 -> (match %t2 with [] -> (%t1 ()) | x :: _ -> x)))) in (let b = (second (0 :: l)) in (let rec last %t3 = (let %t4 = (fun _ -> (match %t3 with [] -> (raise Failure) | _ :: l -> (last l))) in (match %t3 with [] -> (%t4 ()) | x :: %t5 -> (match %t5 with [] -> x | _ :: _ -> (%t4 ())))) in (let c = (last l) in c)))))))
[exit 0]


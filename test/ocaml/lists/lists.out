$ diva ocaml opt lists.ml
(let Stdlib.List.hd = (fun %p8 -> (match %p8 with [] -> (raise Failure) | a :: _ -> a)) in (let l = (3 :: (1 :: (2 :: []))) in (let a = (Stdlib.List.hd l) in (let second = (fun l -> (match l with [] -> 0 | _ :: %t1 -> (match %t1 with [] -> 0 | x :: _ -> x))) in (let b = (second (0 :: l)) in (let rec last %t2 = (let %t3 = (fun _ -> (match %t2 with [] -> (raise Failure) | _ :: l -> (last l))) in (match %t2 with [] -> (%t3 ()) | x :: %t4 -> (match %t4 with [] -> x | _ :: _ -> (%t3 ())))) in (let c = (last l) in c)))))))
[exit 0]

$ diva ocaml hints lists.ml

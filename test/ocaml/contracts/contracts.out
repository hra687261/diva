$ diva ocaml opt contracts.ml
(let both = (fun a -> (fun b -> (if a then b else false))) in (let rec length l = (let _ = (assert ((List.length l) <= 100)) in (match l with [] -> 0 | _ :: t -> (let %r = (1 + (length t)) in (let _ = (assert (if (-4611686018427387904 <= %r) then (%r <= 4611686018427387903) else false)) in %r)))) in (let has_two = (fun l -> (match l with [] -> false | _ :: %t1 -> (match %t1 with [] -> false | _ :: _ -> true))) in (if ((both true) (has_two (3 :: (4 :: [])))) then (let _ = (length (1 :: (2 :: []))) in ()) else ()))))
[exit 0]


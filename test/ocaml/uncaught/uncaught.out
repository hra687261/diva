$ diva ocaml opt uncaught.ml
(let check = (fun x -> (if (x < 0) then (raise (Neg x)) else x)) in (let safe = (try (check -1) with %exn -> (match %exn with Neg n -> n | _ -> (raise %exn))) in (let bad = (check -2) in (let wrong = (try (raise Not_found) with %exn -> (match %exn with Neg n -> n | _ -> (raise %exn))) in wrong))))
[exit 0]

